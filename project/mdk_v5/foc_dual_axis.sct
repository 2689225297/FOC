; AT32F403ACGU7 产品固件链接脚本。
; 代码区截止到 0x080FEFFF，最后 4KiB 保留为参数槽 A/B。
; 参数槽地址和 storage_parameter.h 中的冻结常量必须同时更新。

LR_IROM1 0x08000000 0x000FF000  {
  ER_IROM1 0x08000000 0x000FF000  {
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00018000  {
    .ANY (+RW +ZI)
  }
}
